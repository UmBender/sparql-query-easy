{
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git rev-parse *)",
      "Bash(git branch --show-current)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git stash *)",
      "Bash(git stash)",
      "Bash(rg *)",
      "Bash(ls)",
      "Bash(ls *)",
      "Bash(wc *)",
      "Bash(mkdir *)",
      "Bash(sort *)",
      "Bash(./gradlew *)",
      "Bash(npm --prefix frontend run *)",
      "Bash(npm --prefix frontend test)",
      "Bash(npm --prefix frontend test *)",
      "Bash(node scripts/*)",
      "Bash(node frontend/scripts/*)"
    ],
    "deny": [
      "AskUserQuestion",
      "Agent",
      "EnterPlanMode",
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git rebase *)",
      "Bash(git clean *)",
      "Bash(git restore *)",
      "Bash(git branch -D *)",
      "Bash(git branch -d *)",
      "Bash(git commit --amend *)",
      "Bash(git tag *)",
      "Bash(git switch *)",
      "Bash(git checkout *)",
      "Bash(git merge *)",
      "Bash(git config *)",
      "Bash(git worktree *)",
      "Bash(* --no-verify*)",
      "Bash(rm -rf *)",
      "Bash(sudo *)",
      "Bash(gh *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(npm * install*)",
      "Bash(npm * ci*)",
      "Bash(npm install*)",
      "Bash(npm ci*)",
      "Bash(claude *)",
      "Bash(*batch.sh*)",
      "Read(.batch/state/**)",
      "Read(.batch/queue)",
      "Edit(.batch/state/**)",
      "Edit(.batch/queue)",
      "Edit(.batch/settings.json)",
      "Edit(scripts/batch/**)",
      "Read(.env)",
      "Edit(.env)"
    ]
  }
}
