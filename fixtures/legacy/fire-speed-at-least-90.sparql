PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
SELECT DISTINCT ?speed ?speedLabel
WHERE {
?pokemon <http://easyquery.example.org/pokemon#hasType> <http://easyquery.example.org/pokemon#FireType> .
OPTIONAL {
?speed rdfs:label ?speedLabel .
FILTER (lang(?speedLabel) = "en")
}
?pokemon <http://easyquery.example.org/pokemon#speed> ?speed .
OPTIONAL {
?speed rdfs:label ?speedLabel .
FILTER (lang(?speedLabel) = "en")
}
FILTER (isLiteral(?speed) && ?speed >= 90)
}
LIMIT 150
