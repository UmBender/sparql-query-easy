PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
SELECT DISTINCT ?name ?nameLabel
WHERE {
?pokemon <http://easyquery.example.org/pokemon#hasType> <http://easyquery.example.org/pokemon#PsychicType> .
OPTIONAL {
?name rdfs:label ?nameLabel .
FILTER (lang(?nameLabel) = "en")
}
?pokemon <http://www.w3.org/2000/01/rdf-schema#label> ?name .
OPTIONAL {
?name rdfs:label ?nameLabel .
FILTER (lang(?nameLabel) = "en")
}
FILTER (isLiteral(?name) && str(?name) = "Kadabra")
}
LIMIT 150
