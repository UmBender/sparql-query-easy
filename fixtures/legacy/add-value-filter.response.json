      "data": "PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>\nPREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>\nPREFIX owl: <http://www.w3.org/2002/07/owl#>\nSELECT DISTINCT ?value_<ts1> ?value_<ts1>Label\nWHERE {\n?pokemon <http://easyquery.example.org/pokemon#hasType> <http://easyquery.example.org/pokemon#FireType> .\nOPTIONAL {\n?value_<ts1> rdfs:label ?value_<ts1>Label .\nFILTER (lang(?value_<ts1>Label) = \"en\")\n}\n?pokemon <http://easyquery.example.org/pokemon#speed> ?value_<ts1> .\nOPTIONAL {\n?value_<ts1> rdfs:label ?value_<ts1>Label .\nFILTER (lang(?value_<ts1>Label) = \"en\")\n}\nFILTER (isLiteral(?value_<ts1>) && ?value_<ts1> >= 100)\n}\nLIMIT 150\n"
