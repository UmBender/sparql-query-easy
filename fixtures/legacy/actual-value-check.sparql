PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
SELECT DISTINCT ?type ?typeLabel
WHERE {
<http://easyquery.example.org/pokemon#Pikachu> <http://easyquery.example.org/pokemon#speed> ?literalValue0 .
FILTER (str(?literalValue0) = "100") .
OPTIONAL {
?type rdfs:label ?typeLabel .
FILTER (lang(?typeLabel) = "en")
}
<http://easyquery.example.org/pokemon#Pikachu> <http://easyquery.example.org/pokemon#hasType> ?type .
OPTIONAL {
?type rdfs:label ?typeLabel .
FILTER (lang(?typeLabel) = "en")
}
}
LIMIT 150
