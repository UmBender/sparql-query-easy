PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
SELECT DISTINCT ?speed ?speedLabel
WHERE {
<http://easyquery.example.org/pokemon#Pikachu> <http://easyquery.example.org/pokemon#speed> ?speed .
OPTIONAL {
?speed rdfs:label ?speedLabel .
FILTER (lang(?speedLabel) = "en")
}
FILTER (isLiteral(?speed))
}
LIMIT 150
