PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
SELECT DISTINCT ?pokemon ?pokemonLabel
WHERE {
?pokemon <http://easyquery.example.org/pokemon#hasType> <http://easyquery.example.org/pokemon#WaterType> .
OPTIONAL {
?pokemon rdfs:label ?pokemonLabel .
FILTER (lang(?pokemonLabel) = "en")
}
?pokemon <http://easyquery.example.org/pokemon#hp> ?literalValue1 .
FILTER (str(?literalValue1) = "80..100") .
OPTIONAL {
?pokemon rdfs:label ?pokemonLabel .
FILTER (lang(?pokemonLabel) = "en")
}
}
LIMIT 150
