# OPS-008: settings of `node scripts/check-https-modes.mjs auto` only.
# Throwaway values on 127.0.0.1; never use them for a real deployment.
POSTGRES_PASSWORD=https-check-only
EASYQUERY_ENVIRONMENT=production
EASYQUERY_HTTPS_MODE=auto
# *.localhost never leaves the machine; `internal` is Caddy's own CA.
EASYQUERY_DOMAIN=easyquery.localhost
EASYQUERY_TLS=internal
WEB_PORT=18180
WEB_HTTPS_PORT=18543
EASYQUERY_AUTH_ATTEMPTS_PER_MINUTE=1000
