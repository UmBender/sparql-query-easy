# OPS-008: settings of `node scripts/check-https-modes.mjs proxy` only.
# Throwaway values on 127.0.0.1; never use them for a real deployment.
POSTGRES_PASSWORD=https-check-only
EASYQUERY_ENVIRONMENT=production
EASYQUERY_HTTPS_MODE=proxy
# Only the stand-in proxy `edge` (deploy/test/compose.edge.yaml) is trusted.
EASYQUERY_TRUSTED_PROXIES=172.30.99.10/32
# Direct to web (bypassing the proxy) and through edge.
WEB_PORT=18190
EDGE_PORT=18191
# Small, so the check reaches the limit quickly.
EASYQUERY_AUTH_ATTEMPTS_PER_MINUTE=3
