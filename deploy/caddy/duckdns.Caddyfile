# OPS-013, EASYQUERY_HTTPS_MODE=duckdns: like `dns`, but the DNS-01 challenge
# goes through DuckDNS (free <name>.duckdns.org subdomain, no domain to buy).
# The TXT record is created with DUCKDNS_TOKEN, so no port 80/443 is needed and
# the site is served at https://<name>.duckdns.org:<WEB_HTTPS_PORT>. The A record
# (set in the DuckDNS page) may point at a university-internal address: the
# challenge never connects to the server. Certificates are trusted, renew by
# themselves and live in the caddy-data volume.
{
	admin off
	# HTTP/3 needs UDP 443, which compose.yaml does not publish.
	servers {
		protocols h1 h2
	}
}

{$EASYQUERY_DOMAIN} {
	tls {
		dns duckdns {env.DUCKDNS_TOKEN}
	}
	import /etc/caddy/site.caddy
	header Strict-Transport-Security "max-age=31536000"
}
