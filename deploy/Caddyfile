# OPS-006: one origin for the SPA and the API. Local HTTP only; TLS is OPS-002.
{
	admin off
	auto_https off
}

:80 {
	encode zstd gzip

	# API, documentation and the legacy page (until FE-049) come from the backend.
	# reverse_proxy keeps the Host header (the backend's same-origin check needs it)
	# and sets X-Forwarded-For (EASYQUERY_TRUST_PROXY=true).
	@backend {
		path /api/* /health /openapi.json /swagger /swagger/*
		path /index2.html /login.html /index2.css /grafos.css
		path /cytoscape.min.js /cytoscape-cxtmenu.js /app-core.js /stage-order.js /stage-exploration.js
		path /filter-funnel.js /filter-badges.js /graph-nodes.js /graph-menus.js
		path /query-calculations.js /query-stages.js /graph-actions.js /graph-model.js /graph-binding.js
	}
	handle @backend {
		reverse_proxy backend:8080
	}

	# Everything else is the SPA; unknown paths fall back to index.html.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}
