# QUAL-017: settings of the compose smoke test only (compose.test.yaml).
# Throwaway values for a stack that lives for one test run on 127.0.0.1;
# never use them for a real deployment (OPS-006 runbook).
POSTGRES_PASSWORD=compose-smoke-only
WEB_PORT=18097
EASYQUERY_ENVIRONMENT=production
# tests-stack/support.ts seeds study data as this admin.
EASYQUERY_ADMIN_USERNAMES=stack-admin
# Many registrations from one address in one run.
EASYQUERY_AUTH_ATTEMPTS_PER_MINUTE=1000
