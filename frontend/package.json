{
	"name": "frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint . && node scripts/check-raw-colors.mjs",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:coverage && vitest run --project client && npm run test:e2e",
		"test:e2e": "playwright test",
		"tokens": "UPDATE_TOKENS=1 vitest run src/lib/design/css.spec.ts",
		"test:coverage": "vitest run --project server --coverage",
		"api:types": "node scripts/generate-api-types.mjs",
		"test:stack": "playwright test --config playwright.stack.config.ts",
		"test:screens": "node scripts/test-screens.mjs",
		"test:compose": "node scripts/test-compose.mjs"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.10.2",
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/inter": "^5.3.0",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.59.0",
		"@playwright/test": "1.63.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/cytoscape": "^3.21.9",
		"@types/node": "^22",
		"@vitest/browser": "^4.1.12",
		"@vitest/browser-playwright": "^4.1.12",
		"@vitest/coverage-v8": "^4.1.12",
		"bits-ui": "^2.19.5",
		"cn": "^0.5.0",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"mode-watcher": "^1.1.0",
		"msw": "^2.15.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"shadcn-svelte": "^1.7.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"svelte-sonner": "^1.2.1",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.12",
		"vitest-browser-svelte": "^3.1.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@tanstack/svelte-query": "^6.3.4",
		"cytoscape": "^3.33.1",
		"sveltekit-superforms": "^3.0.0",
		"zod": "^4.6.7"
	}
}
