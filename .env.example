# SPARQL EasyQuery local settings. Copy to `.env` (git-ignored) and adjust.
# `docker compose` reads the same file (tcc/07 - Operations/Docker Compose Stack.md).
# The app reads `.env` from its working directory at startup; a real
# environment variable with the same name wins. With Docker, pass the file
# with `docker run --env-file .env ...`.

# Most rows a query with a MAX or MIN filter may return (all ties are kept
# up to this cap). Whole number from 1 to 10000; default 100.
EASYQUERY_EXTREME_RESULT_LIMIT=100

# `development` (default) or `production`. Production requires a database.
EASYQUERY_ENVIRONMENT=development

# PostgreSQL (accounts and studies). Leave EASYQUERY_DB_URL empty to run
# without a database; query routes work either way. Never commit a password.
EASYQUERY_DB_URL=
EASYQUERY_DB_USER=
EASYQUERY_DB_PASSWORD=
# Local development database (OPS-007): start only PostgreSQL with
#   docker compose -f compose.yaml -f compose.dev.yaml up -d --wait db
# then use these instead of the three empty lines above. The user and password
# are POSTGRES_USER and POSTGRES_PASSWORD below; the port is DB_PORT.
# EASYQUERY_DB_URL=jdbc:postgresql://127.0.0.1:5432/easyquery
# EASYQUERY_DB_USER=easyquery
# EASYQUERY_DB_PASSWORD=<the POSTGRES_PASSWORD value>
# Connection pool size, whole number from 1 to 50; default 5.
EASYQUERY_DB_POOL_SIZE=5

# Accounts (AUTH-001). Argon2id cost; defaults are the OWASP minimum.
# Memory in KiB (1024-1048576), passes (1-10), lanes (1-16).
EASYQUERY_ARGON2_MEMORY_KIB=19456
EASYQUERY_ARGON2_ITERATIONS=2
EASYQUERY_ARGON2_PARALLELISM=1
# Login and registration attempts per client address per minute (1-1000).
EASYQUERY_AUTH_ATTEMPTS_PER_MINUTE=10
# true only behind the bundled reverse proxy: the client address then comes
# from X-Forwarded-For. Session cookies are Secure when
# EASYQUERY_ENVIRONMENT=production.
EASYQUERY_TRUST_PROXY=false
# Usernames with the admin role (AUTH-005), comma-separated, case-insensitive;
# everyone else is a participant. Empty means no admin.
EASYQUERY_ADMIN_USERNAMES=

# Docker Compose stack (OPS-006). POSTGRES_PASSWORD is required there; the
# backend service gets its EASYQUERY_DB_* values from these, and sets
# EASYQUERY_TRUST_PROXY=true itself. Never commit a password.
POSTGRES_DB=easyquery
POSTGRES_USER=easyquery
POSTGRES_PASSWORD=
# Host port of the web service's HTTP listener, and the address it is
# published on (127.0.0.1: only this machine).
WEB_PORT=8080
WEB_BIND=127.0.0.1

# HTTPS (OPS-008). EASYQUERY_HTTPS_MODE chooses how the public origin is served:
#   local  plain HTTP on WEB_BIND:WEB_PORT (default; development and tests).
#   auto   Caddy obtains a certificate for EASYQUERY_DOMAIN itself. Needs the
#          DNS name pointing here and ports 80 and 443 open:
#            WEB_BIND=0.0.0.0  WEB_PORT=80  WEB_HTTPS_BIND=0.0.0.0  WEB_HTTPS_PORT=443
#   proxy  the university proxy ends TLS and forwards plain HTTP to
#          WEB_BIND:WEB_PORT; set WEB_BIND to the address the proxy reaches.
# Session cookies need HTTPS on any host but localhost: use auto or proxy with
# EASYQUERY_ENVIRONMENT=production on the server.
EASYQUERY_HTTPS_MODE=local
# auto: the public DNS name, without scheme or port.
EASYQUERY_DOMAIN=
# auto: the e-mail address Let's Encrypt uses for expiry notices (or
# `internal` for Caddy's own CA, which browsers do not trust: tests only).
EASYQUERY_TLS=
# auto: host address and port of the HTTPS listener. Empty port: a random
# loopback port nothing uses (local and proxy modes).
WEB_HTTPS_BIND=127.0.0.1
WEB_HTTPS_PORT=
# proxy: CIDR ranges of the university proxy, separated by spaces (for
# example 10.20.30.40/32). Only they may name the client in X-Forwarded-For.
EASYQUERY_TRUSTED_PROXIES=
# Host port of the database, published only with compose.dev.yaml (OPS-007,
# bound to 127.0.0.1). Match it in EASYQUERY_DB_URL.
DB_PORT=5432
