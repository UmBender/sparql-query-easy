#################################################################
#    Pokémon
#################################################################

###  #001 Bulbasaur
pk:Bulbasaur
    rdf:type pk:Pokemon ;
    rdfs:label "Bulbasaur"@en ;
    pk:pokedexNumber 1 ;
    pk:category "Seed Pokémon"@en ;
    pk:heightMeters 0.7 ;
    pk:weightKilograms 6.9 ;
    pk:primaryType pk:GrassType ;
    pk:secondaryType pk:PoisonType ;
    pk:hasType pk:GrassType , pk:PoisonType ;
    pk:hp 45 ;
    pk:attack 49 ;
    pk:defense 49 ;
    pk:specialAttack 65 ;
    pk:specialDefense 65 ;
    pk:speed 45 ;
    pk:baseStatTotal 318 ;
    pk:weakTo pk:FireType , pk:IceType , pk:FlyingType , pk:PsychicType ;
    pk:resistantTo pk:WaterType , pk:ElectricType , pk:GrassType , pk:FightingType , pk:FairyType ;
    pk:strongAgainst pk:WaterType , pk:GrassType , pk:GroundType , pk:RockType , pk:FairyType ;
    pk:inEvolutionFamily pk:BulbasaurFamily ;
