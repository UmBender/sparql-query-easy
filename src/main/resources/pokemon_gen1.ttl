# First-generation Pokémon (National Pokédex #001-#151) for SPARQL EasyQuery (DATA-002, DATA-003).
# Generated by scripts/generate-pokemon-dataset.mjs; edit the script, not this file.
# Current-game typing, base stats and type chart; evolutions counted within these 151.
# strongAgainst comes from each Pokémon's own types; lore links cite their source game in the generator.
@prefix pk: <http://easyquery.example.org/pokemon#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#################################################################
#    Classes
#################################################################

pk:Pokemon
    rdf:type owl:Class ;
    rdfs:label "Pokémon"@en .

pk:Type
    rdf:type owl:Class ;
    rdfs:label "Type"@en .

pk:EvolutionFamily
    rdf:type owl:Class ;
    rdfs:label "Evolution family"@en .

pk:EvolutionTrigger
    rdf:type owl:Class ;
    rdfs:label "Evolution trigger"@en .

pk:Item
    rdf:type owl:Class ;
    rdfs:label "Item"@en .

#################################################################
#    Object properties
#################################################################

pk:primaryType
    rdf:type owl:ObjectProperty ;
    rdfs:domain pk:Pokemon ;
    rdfs:range pk:Type ;
    rdfs:label "primary type"@en .

pk:secondaryType
    rdf:type owl:ObjectProperty ;
    rdfs:domain pk:Pokemon ;
    rdfs:range pk:Type ;
    rdfs:label "secondary type"@en .

pk:hasType
    rdf:type owl:ObjectProperty ;
    rdfs:domain pk:Pokemon ;
    rdfs:range pk:Type ;
    rdfs:label "has type"@en .

pk:weakTo
    rdf:type owl:ObjectProperty ;
    rdfs:domain pk:Pokemon ;
    rdfs:range pk:Type ;
    rdfs:label "weak to"@en .

pk:fourTimesWeakTo
    rdf:type owl:ObjectProperty ;
    rdfs:domain pk:Pokemon ;
    rdfs:range pk:Type ;
    rdfs:label "four times weak to"@en .

pk:resistantTo
    rdf:type owl:ObjectProperty ;
    rdfs:domain pk:Pokemon ;
    rdfs:range pk:Type ;
    rdfs:label "resistant to"@en .

pk:immuneTo
    rdf:type owl:ObjectProperty ;
    rdfs:domain pk:Pokemon ;
    rdfs:range pk:Type ;
    rdfs:label "immune to"@en .

pk:strongAgainst
    rdf:type owl:ObjectProperty ;
    rdfs:domain pk:Pokemon ;
    rdfs:range pk:Type ;
    rdfs:label "strong against"@en .

pk:evolvesFrom
    rdf:type owl:ObjectProperty ;
    owl:inverseOf pk:evolvesInto ;
    rdfs:domain pk:Pokemon ;
    rdfs:range pk:Pokemon ;
    rdfs:label "evolves from"@en .

pk:evolvesInto
    rdf:type owl:ObjectProperty ;
    owl:inverseOf pk:evolvesFrom ;
    rdfs:domain pk:Pokemon ;
    rdfs:range pk:Pokemon ;
    rdfs:label "evolves into"@en .

pk:evolutionTrigger
    rdf:type owl:ObjectProperty ;
    rdfs:domain pk:Pokemon ;
    rdfs:range pk:EvolutionTrigger ;
    rdfs:label "evolution trigger"@en .

pk:evolutionItem
    rdf:type owl:ObjectProperty ;
    rdfs:domain pk:Pokemon ;
    rdfs:range pk:Item ;
    rdfs:label "evolution item"@en .

pk:inEvolutionFamily
    rdf:type owl:ObjectProperty ;
    rdfs:domain pk:Pokemon ;
    rdfs:range pk:EvolutionFamily ;
    rdfs:label "in evolution family"@en .

pk:nextInPokedex
    rdf:type owl:ObjectProperty ;
    owl:inverseOf pk:previousInPokedex ;
    rdfs:domain pk:Pokemon ;
    rdfs:range pk:Pokemon ;
    rdfs:label "next in Pokédex"@en .

pk:previousInPokedex
    rdf:type owl:ObjectProperty ;
    owl:inverseOf pk:nextInPokedex ;
    rdfs:domain pk:Pokemon ;
    rdfs:range pk:Pokemon ;
    rdfs:label "previous in Pokédex"@en .

pk:pokedexMentions
    rdf:type owl:ObjectProperty ;
    owl:inverseOf pk:mentionedInPokedexOf ;
    rdfs:domain pk:Pokemon ;
    rdfs:range pk:Pokemon ;
    rdfs:label "Pokédex mentions"@en .

pk:mentionedInPokedexOf
    rdf:type owl:ObjectProperty ;
    owl:inverseOf pk:pokedexMentions ;
    rdfs:domain pk:Pokemon ;
    rdfs:range pk:Pokemon ;
    rdfs:label "mentioned in Pokédex of"@en .

pk:superEffectiveAgainst
    rdf:type owl:ObjectProperty ;
    rdfs:domain pk:Type ;
    rdfs:range pk:Type ;
    rdfs:label "super effective against"@en .

pk:notVeryEffectiveAgainst
    rdf:type owl:ObjectProperty ;
    rdfs:domain pk:Type ;
    rdfs:range pk:Type ;
    rdfs:label "not very effective against"@en .

pk:noEffectAgainst
    rdf:type owl:ObjectProperty ;
    rdfs:domain pk:Type ;
    rdfs:range pk:Type ;
    rdfs:label "no effect against"@en .

#################################################################
#    Datatype properties
#################################################################

pk:pokedexNumber
    rdf:type owl:DatatypeProperty ;
    rdfs:domain pk:Pokemon ;
    rdfs:range xsd:integer ;
    rdfs:label "Pokédex number"@en .

pk:category
    rdf:type owl:DatatypeProperty ;
    rdfs:domain pk:Pokemon ;
    rdfs:range rdf:langString ;
    rdfs:label "category"@en .

pk:heightMeters
    rdf:type owl:DatatypeProperty ;
    rdfs:domain pk:Pokemon ;
    rdfs:range xsd:decimal ;
    rdfs:label "height (m)"@en .

pk:weightKilograms
    rdf:type owl:DatatypeProperty ;
    rdfs:domain pk:Pokemon ;
    rdfs:range xsd:decimal ;
    rdfs:label "weight (kg)"@en .

pk:hp
    rdf:type owl:DatatypeProperty ;
    rdfs:domain pk:Pokemon ;
    rdfs:range xsd:integer ;
    rdfs:label "HP"@en .

pk:attack
    rdf:type owl:DatatypeProperty ;
    rdfs:domain pk:Pokemon ;
    rdfs:range xsd:integer ;
    rdfs:label "Attack"@en .

pk:defense
    rdf:type owl:DatatypeProperty ;
    rdfs:domain pk:Pokemon ;
    rdfs:range xsd:integer ;
    rdfs:label "Defense"@en .

pk:specialAttack
    rdf:type owl:DatatypeProperty ;
    rdfs:domain pk:Pokemon ;
    rdfs:range xsd:integer ;
    rdfs:label "Sp. Atk"@en .

pk:specialDefense
    rdf:type owl:DatatypeProperty ;
    rdfs:domain pk:Pokemon ;
    rdfs:range xsd:integer ;
    rdfs:label "Sp. Def"@en .

pk:speed
    rdf:type owl:DatatypeProperty ;
    rdfs:domain pk:Pokemon ;
    rdfs:range xsd:integer ;
    rdfs:label "Speed"@en .

pk:baseStatTotal
    rdf:type owl:DatatypeProperty ;
    rdfs:domain pk:Pokemon ;
    rdfs:range xsd:integer ;
    rdfs:label "base stat total"@en .

pk:evolutionStage
    rdf:type owl:DatatypeProperty ;
    rdfs:domain pk:Pokemon ;
    rdfs:range xsd:integer ;
    rdfs:label "evolution stage"@en .

pk:evolutionLevel
    rdf:type owl:DatatypeProperty ;
    rdfs:domain pk:Pokemon ;
    rdfs:range xsd:integer ;
    rdfs:label "evolution level"@en .

pk:pokedexLoreNote
    rdf:type owl:DatatypeProperty ;
    rdfs:domain pk:Pokemon ;
    rdfs:range rdf:langString ;
    rdfs:label "Pokédex lore note"@en .

#################################################################
#    Types
#################################################################

pk:NormalType
    rdf:type pk:Type ;
    rdfs:label "Normal"@en ;
    pk:notVeryEffectiveAgainst pk:RockType , pk:SteelType ;
    pk:noEffectAgainst pk:GhostType .

pk:FireType
    rdf:type pk:Type ;
    rdfs:label "Fire"@en ;
    pk:superEffectiveAgainst pk:GrassType , pk:IceType , pk:BugType , pk:SteelType ;
    pk:notVeryEffectiveAgainst pk:FireType , pk:WaterType , pk:RockType , pk:DragonType .

pk:WaterType
    rdf:type pk:Type ;
    rdfs:label "Water"@en ;
    pk:superEffectiveAgainst pk:FireType , pk:GroundType , pk:RockType ;
    pk:notVeryEffectiveAgainst pk:WaterType , pk:GrassType , pk:DragonType .

pk:ElectricType
    rdf:type pk:Type ;
    rdfs:label "Electric"@en ;
    pk:superEffectiveAgainst pk:WaterType , pk:FlyingType ;
    pk:notVeryEffectiveAgainst pk:ElectricType , pk:GrassType , pk:DragonType ;
    pk:noEffectAgainst pk:GroundType .

pk:GrassType
    rdf:type pk:Type ;
    rdfs:label "Grass"@en ;
    pk:superEffectiveAgainst pk:WaterType , pk:GroundType , pk:RockType ;
    pk:notVeryEffectiveAgainst pk:FireType , pk:GrassType , pk:PoisonType , pk:FlyingType , pk:BugType , pk:DragonType , pk:SteelType .

pk:IceType
    rdf:type pk:Type ;
    rdfs:label "Ice"@en ;
    pk:superEffectiveAgainst pk:GrassType , pk:GroundType , pk:FlyingType , pk:DragonType ;
    pk:notVeryEffectiveAgainst pk:FireType , pk:WaterType , pk:IceType , pk:SteelType .

pk:FightingType
    rdf:type pk:Type ;
    rdfs:label "Fighting"@en ;
    pk:superEffectiveAgainst pk:NormalType , pk:IceType , pk:RockType , pk:DarkType , pk:SteelType ;
    pk:notVeryEffectiveAgainst pk:PoisonType , pk:FlyingType , pk:PsychicType , pk:BugType , pk:FairyType ;
    pk:noEffectAgainst pk:GhostType .

pk:PoisonType
    rdf:type pk:Type ;
    rdfs:label "Poison"@en ;
    pk:superEffectiveAgainst pk:GrassType , pk:FairyType ;
    pk:notVeryEffectiveAgainst pk:PoisonType , pk:GroundType , pk:RockType , pk:GhostType ;
    pk:noEffectAgainst pk:SteelType .

pk:GroundType
    rdf:type pk:Type ;
    rdfs:label "Ground"@en ;
    pk:superEffectiveAgainst pk:FireType , pk:ElectricType , pk:PoisonType , pk:RockType , pk:SteelType ;
    pk:notVeryEffectiveAgainst pk:GrassType , pk:BugType ;
    pk:noEffectAgainst pk:FlyingType .

pk:FlyingType
    rdf:type pk:Type ;
    rdfs:label "Flying"@en ;
    pk:superEffectiveAgainst pk:GrassType , pk:FightingType , pk:BugType ;
    pk:notVeryEffectiveAgainst pk:ElectricType , pk:RockType , pk:SteelType .

pk:PsychicType
    rdf:type pk:Type ;
    rdfs:label "Psychic"@en ;
    pk:superEffectiveAgainst pk:FightingType , pk:PoisonType ;
    pk:notVeryEffectiveAgainst pk:PsychicType , pk:SteelType ;
    pk:noEffectAgainst pk:DarkType .

pk:BugType
    rdf:type pk:Type ;
    rdfs:label "Bug"@en ;
    pk:superEffectiveAgainst pk:GrassType , pk:PsychicType , pk:DarkType ;
    pk:notVeryEffectiveAgainst pk:FireType , pk:FightingType , pk:PoisonType , pk:FlyingType , pk:GhostType , pk:SteelType , pk:FairyType .

pk:RockType
    rdf:type pk:Type ;
    rdfs:label "Rock"@en ;
    pk:superEffectiveAgainst pk:FireType , pk:IceType , pk:FlyingType , pk:BugType ;
    pk:notVeryEffectiveAgainst pk:FightingType , pk:GroundType , pk:SteelType .

pk:GhostType
    rdf:type pk:Type ;
    rdfs:label "Ghost"@en ;
    pk:superEffectiveAgainst pk:PsychicType , pk:GhostType ;
    pk:notVeryEffectiveAgainst pk:DarkType ;
    pk:noEffectAgainst pk:NormalType .

pk:DragonType
    rdf:type pk:Type ;
    rdfs:label "Dragon"@en ;
    pk:superEffectiveAgainst pk:DragonType ;
    pk:notVeryEffectiveAgainst pk:SteelType ;
    pk:noEffectAgainst pk:FairyType .

pk:DarkType
    rdf:type pk:Type ;
    rdfs:label "Dark"@en ;
    pk:superEffectiveAgainst pk:PsychicType , pk:GhostType ;
    pk:notVeryEffectiveAgainst pk:FightingType , pk:DarkType , pk:FairyType .

pk:SteelType
    rdf:type pk:Type ;
    rdfs:label "Steel"@en ;
    pk:superEffectiveAgainst pk:IceType , pk:RockType , pk:FairyType ;
    pk:notVeryEffectiveAgainst pk:FireType , pk:WaterType , pk:ElectricType , pk:SteelType .

pk:FairyType
    rdf:type pk:Type ;
    rdfs:label "Fairy"@en ;
    pk:superEffectiveAgainst pk:FightingType , pk:DragonType , pk:DarkType ;
    pk:notVeryEffectiveAgainst pk:FireType , pk:PoisonType , pk:SteelType .

