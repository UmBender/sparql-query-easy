@prefix ex: <https://example.test/literal/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:subject a owl:Class ;
    rdfs:label "Literal holder"@en ;
    ex:plain "plain text" ;
    ex:english "hello"@en ;
    ex:portuguese "olá"@pt-BR ;
    ex:typed "typed text"^^xsd:string ;
    ex:escaped "quote: \"; slash: \\; newline: \n; tab: \t" .
