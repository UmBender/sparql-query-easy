# QUAL-009 upload scenario: a tiny graph in the PokemonGen1 vocabulary.
@prefix pk: <http://easyquery.example.org/pokemon#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

pk:Embercub
    rdfs:label "Embercub"@en ;
    pk:hasType pk:FireType ;
    pk:speed 70 .

pk:Blazewing
    rdfs:label "Blazewing"@en ;
    pk:hasType pk:FireType , pk:FlyingType ;
    pk:speed 110 .

pk:Puddlefin
    rdfs:label "Puddlefin"@en ;
    pk:hasType pk:WaterType ;
    pk:speed 55 .

pk:FireType
    rdfs:label "Fire"@en .
